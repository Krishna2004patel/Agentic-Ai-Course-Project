# ==============================================================================
# RESEARCH GRANT MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Institution: KLE Technological University
# ==============================================================================

# Database Configuration (SQLite by default; supports PostgreSQL)
DATABASE_URL=sqlite:///./data/grant_system.db

# LLM Provider Configuration
# Mode flag: set to 'true' to use the verified deterministic agentic reasoning engine
# Set to 'false' if providing OpenAI or Ollama credentials
DEMO_MODE=true

# 1. OpenAI-Compatible Provider (e.g. OpenAI GPT-4o-mini, Groq, local vLLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 2. Local Ollama Provider (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Document Upload Directory
UPLOAD_DIR=./data/uploads
